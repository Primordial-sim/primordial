data_historica.json
historico_evolucion.json
logs/
*.log
simulacion.txt
reporte_*.csv
reporte_*.json
*_simulacion_*.csv
*_simulacion_*.json

# Datos temporales (carpeta data/)
data/*.json
data/*.csv

# Escenarios personalizados del usuario
scenarios/custom_*.json

